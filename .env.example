# SAQR — Environment Variables (Copy to .env and fill in real values; NEVER commit .env)

# PostgreSQL 16 (used in Docker Compose; omit for local SQLite fallback)
POSTGRES_USER=saqr
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=saqr
DATABASE_URL=postgresql://saqr:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/saqr

# Control-Plane Security Secrets
SAQR_WEBHOOK_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARS_HMAC_SECRET
SAQR_JWT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARS_JWT_SECRET
SAQR_ANALYST_PASSWORD=CHANGE_ME_ANALYST_PASSWORD

# Wazuh Manager REST API (v4.14.11 — create dedicated RBAC user with active-response:command)
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_WAZUH_API_PASSWORD
WAZUH_VERIFY_TLS=false
WAZUH_DRY_RUN=false

# AI Reporting Layer (Supports BOTH README's Gemini API AND Proposal Objective #3's Local LLM!)
# Options: gemini | ollama | offline
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Telegram Bot Notifications (Optional — failed sends queue automatically in PostgreSQL outbox)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protected Organization Brand Domains (Scenario 2: Phishing Homoglyph Detection)
PROTECTED_DOMAINS=saqr-bank.ly,ministry-health.gov.ly,saraya.edu.ly
